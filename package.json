{
  "name": "algorithm-visualization-project",
  "version": "1.0.0",
  "description": "An educational tool that helps users understand the logic and behavior of classic algorithms through step-by-step visualizations, pseudocode synchronization, and a \"Test Yourself\" interactive mode. The platform is designed to promote active learning, reinforce key algorithmic concepts, and allow for user interaction at each stage.",
  "repository": {
    "type": "git",
    "url": "https://gitlab.csi.miamioh.edu/2026-senior-design-projects/algorithm-visualization-project/algorithm-visualization-project.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "rimraf build screenshots .vitest-attachments",
    "dev": "react-router dev",
    "dev-host": "react-router dev --host",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "lint": "eslint .",
    "update-deps": "npm-check-updates -u && npm install",
    "force-update-deps": "npm-check-updates -u && rimraf node_modules .react-router package-lock.json && npm install",
    "update-nvmrc": "node --version > .nvmrc",
    "build-g4": "rimraf app/hooks/interpreter/.antlr && npx antlr-ng -Dlanguage=TypeScript -v -o app/hooks/interpreter/.antlr app/hooks/interpreter/Pseudocode.g4"
  },
  "dependencies": {
    "@material-tailwind/react": "^3.0.0-beta.24",
    "@monaco-editor/react": "^4.8.0-rc.2",
    "@react-router/node": "^7.14.2",
    "@react-router/serve": "^7.14.2",
    "html-to-image": "1.11.13",
    "iconoir-react": "^7.11.0",
    "isbot": "^5.1.39",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@react-router/dev": "^7.14.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.5",
    "antlr4ng": "^3.0.16",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.5.0",
    "npm-check-updates": "^21.0.3",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.9",
    "vitest": "^4.1.5",
    "vitest-browser-react": "^2.2.0"
  },
  "overrides": {
    "@tanstack/react-ranger": {
      "react": "$react"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "@react-router/dev": {
      "typescript": "$typescript"
    },
    "monaco-editor": {
      "dompurify": "^3.3.2"
    }
  }
}
