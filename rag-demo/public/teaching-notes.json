    "id": "lomuto_partition.note.2",
    "kind": "teaching_note",
    "tutor_visible": true,
    "text": "Before each j, positions low through i contain values strictly smaller than the pivot. Preconditions: Nonempty integer array and 0 <= low <= high < length(a). Return final pivot index. Partition only the selected interval."
  },
  {
    "algorithm": "lomuto_partition",
    "title": "Lomuto Partition",
    "validation_status": "machine-validated",
    "program_sha256": "d68fb459255683512ddf9b5009eefe4ff23ee2f299870b8eea69c00e3be06471",
    "configuration_sha256": "610e0870d387c5dda1fd547363f848f90f54f17567d053fd6fc679d0830dd0c2",
