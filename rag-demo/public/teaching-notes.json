    "tutor_visible": true,
    "text": "Scan inward until the left value is at least the pivot and the right value is at most the pivot. Preconditions: Nonempty integer array and 0 <= low <= high < length(a). Return a split index, not necessarily the pivot position."
  },
  {
    "algorithm": "hoare_partition",
    "title": "Hoare Partition",
    "validation_status": "machine-validated",
    "program_sha256": "ce4ed440c1431f2f6da068f022092850009242bfcc2e0face94f2128423029a0",
    "configuration_sha256": "2493e40390448216dff573eb561ab87c7037a72e65034b4fdd687ea908920e03",
