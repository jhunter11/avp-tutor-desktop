    "id": "lomuto_partition.excerpt",
    "kind": "avp_excerpt",
    "tutor_visible": true,
    "text": "AVP reference excerpt (not a complete solution):\n    pivot = a[high]\n    i = low - 1\n    for (j = low; j < high; j += 1):"
  },
