    "id": "lomuto_partition.note.3",
    "kind": "teaching_note",
    "tutor_visible": true,
    "text": "The final swap places the pivot at i + 1; partitioning does not fully sort either side. Preconditions: Nonempty integer array and 0 <= low <= high < length(a). Return final pivot index. Partition only the selected interval."
  },
  {
    "algorithm": "lomuto_partition",
    "title": "Lomuto Partition",
    "validation_status": "machine-validated",
    "program_sha256": "d68fb459255683512ddf9b5009eefe4ff23ee2f299870b8eea69c00e3be06471",
