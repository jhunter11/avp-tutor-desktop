// Binary Search

fun Binary_Search(@init<table> a, key):
    low = 0
    high = length(a) - 1
    while (low <= high):
        mid = floor((low + high) / 2)
        if (a[mid] == key):
            return mid
        else if (a[mid] < key):
            low = mid + 1
        else:
            high = mid - 1
        end if
    end while
    return -1
end fun

