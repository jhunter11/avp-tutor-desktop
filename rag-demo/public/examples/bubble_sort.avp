// Bubble Sort

fun Bubble_Sort(@init<table> a):
    n = length(a)
    for (i = 0; i < n - 1; i += 1):
        changed = 0
        for (j = 0; j < n - i - 1; j += 1):
            if (a[j] > a[j + 1]):
                swap(a[j], a[j + 1])
                changed = 1
            end if
        end for
        if (changed == 0):
            break
        end if
    end for
    return a
end fun

