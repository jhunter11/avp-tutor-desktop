// Selection Sort

fun Selection_Sort(@init<table> a):
    n = length(a)
    for (i = 0; i < n - 1; i += 1):
        minimum = i
        for (j = i + 1; j < n; j += 1):
            if (a[j] < a[minimum]):
                minimum = j
            end if
        end for
        swap(a[i], a[minimum])
    end for
    return a
end fun

