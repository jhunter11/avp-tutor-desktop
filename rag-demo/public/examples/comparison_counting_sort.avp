// Comparison Counting Sort

fun Comparison_Counting_Sort(@init<table> a):
    n = length(a)
    count = arr(n)
    output = arr(n)
    for (i = 0; i < n - 1; i += 1):
        for (j = i + 1; j < n; j += 1):
            if (a[i] <= a[j]):
                count[j] += 1
            else:
                count[i] += 1
            end if
        end for
    end for
    for (i = 0; i < n; i += 1):
        output[count[i]] = a[i]
    end for
    return output
end fun

