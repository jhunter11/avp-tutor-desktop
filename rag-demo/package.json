{
  "name": "avp-rag-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5192 --strictPort",
    "build": "tsc --noEmit && vite build",
    "engine": "node tools/build-engine.mjs",
    "validate": "npm run engine && node tools/validate-examples.mjs",
    "test": "npm run validate && npm run index && .venv/bin/python -m unittest discover -s tests -v",
    "verify": "npm test && npm run test:visualization && npm run evaluate:rag && npm run build",
    "test:visualization": "node --experimental-strip-types --test tests/vector-math.node.test.ts",
    "evaluate:challenge": ".venv/bin/python tools/evaluate-challenge.py",
    "animation:export": ".venv/bin/python tools/export-animation.py",
    "animation:render": ".venv-manim/bin/python tools/render-animation.py",
    "vectors": ".venv/bin/python tools/build-vectors.py",
    "evaluate:rag": ".venv/bin/python tools/evaluate-rag.py",
    "rag:server": ".venv/bin/python -m backend.rag_server --port 8783",
    "index": ".venv/bin/python tools/build-corpus.py && npm run validate:syntax && npm run vectors",
    "validate:syntax": "npm run engine && node tools/validate-syntax.mjs",
    "animation:preview": ".venv-manim/bin/python tools/render-animation.py --preview",
    "animation:check": ".venv/bin/python tools/check-animation-layout.py"
  },
  "dependencies": {
    "antlr4ng": "3.0.16"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
