# This is a reference, not automatically loaded by the Python service.
# Export these values in the server environment. Never use VITE_ for secrets.
TUTOR_PROVIDER=openrouter
TUTOR_MODEL=nvidia/nemotron-3.5-super-vl:free
TUTOR_API_KEY_FILE=/absolute/path/to/your/local/api-key.txt
TUTOR_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Paid providers remain disabled by default.
# TUTOR_ALLOW_PAID=1
